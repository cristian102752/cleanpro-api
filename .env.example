# Entorno: development | test | production
NODE_ENV=development
PORT=4000

# Conexión a MongoDB (local o Atlas)
MONGODB_URL=mongodb://127.0.0.1:27017/cleanpro

# Seguridad JWT
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-seguro
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS, separados por coma (whitelist, nunca *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (peticiones por ventana de 15 minutos)
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
